@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/cmake/Modules")

set(WAVES2AMR_MPI @WAVES2AMR_MPI@)
set(WAVES2AMR_GPU_BACKEND @WAVES2AMR_GPU_BACKEND@)

include(CMakeFindDependencyMacro)

find_dependency(AMReX)

# find_dependency(FFTW) is not used here because environments that set
# CMAKE_FIND_PACKAGE_PREFER_CONFIG=ON (e.g. Spack) skip module mode entirely,
# so FindFFTW.cmake is never invoked. Instead we include the module directly
# with CMAKE_FIND_PACKAGE_NAME set to the correct value so that
# find_package_handle_standard_args does not emit a package-name mismatch
# warning.
set(_waves2amr_saved_find_package_name "${CMAKE_FIND_PACKAGE_NAME}")
set(CMAKE_FIND_PACKAGE_NAME FFTW)
include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/cmake/Modules/FindFFTW.cmake")
set(CMAKE_FIND_PACKAGE_NAME "${_waves2amr_saved_find_package_name}")
unset(_waves2amr_saved_find_package_name)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(@PROJECT_NAME@_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(@PROJECT_NAME@_LIBRARY_DIRS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set(@PROJECT_NAME@_LIBRARIES "@PROJECT_NAME@::@PROJECT_NAME@")

set(@PROJECT_NAME@_FOUND TRUE)
check_required_components(@PROJECT_NAME@)
